# Normally written by ./install.sh. To create it by hand, generate each secret with:
#   head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 64
ERP_DOMAIN=erp.example.com
# Email for Let's Encrypt notices, or "internal" for a private-network certificate
ERP_TLS=it@example.com
ERP_SECRET_KEY=
ERP_FIELD_ENCRYPTION_KEY=
DB_OWNER_PASSWORD=
ERP_DB_PASSWORD=
BACKUP_PASSPHRASE=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHS=12
